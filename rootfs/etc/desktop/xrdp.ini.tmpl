; Generated at container start by /usr/local/bin/desktop from /etc/desktop/xrdp.ini.tmpl
[Globals]
ini_version=1
fork=true
port=tcp://${RDP_LISTEN_ADDRESS}:3389
use_vsock=false
tcp_nodelay=true
tcp_keepalive=true
security_layer=tls
crypt_level=high
certificate=${TLS_CERT}
key_file=${TLS_KEY}
ssl_protocols=TLSv1.2, TLSv1.3
autorun=Desktop
allow_channels=true
allow_multimon=true
bitmap_cache=true
bitmap_compression=true
bulk_compression=true
max_bpp=32
new_cursors=true
use_fastpath=both

[Logging]
LogFile=${DESKTOP_RUNTIME_DIR}/log/xrdp.log
LogLevel=INFO
EnableConsole=true
ConsoleLevel=INFO
EnableSyslog=false

[Channels]
rdpdr=false
rdpsnd=true
drdynvc=true
cliprdr=true
rail=false
xrdpvr=false
tcutils=false

; Direct connection to the already running Xorg session: no sesman, no PAM, no root.
[Desktop]
name=Desktop
lib=libxup.so
username=na
password=na
ip=127.0.0.1
port=/run/xrdp/sockdir/xrdp_display_10
chansrvport=DISPLAY(10)
code=20
